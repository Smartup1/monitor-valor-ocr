    def escrever_log(self, msg):
        self.log.config(state="normal")
        self.log.insert("end", f"[{time.strftime('%H:%M:%S')}] {msg}\n")
        self.log.see("end")
        self.log.config(state="disabled")

    def janela_sobre_area(self):
        if self.area is None:
            return False
        self.root.update_idletasks()
        x1, y1 = self.root.winfo_rootx(), self.root.winfo_rooty()
        x2, y2 = x1 + self.root.winfo_width(), y1 + self.root.winfo_height()
        a = self.area
        return not (x2 <= a["left"] or x1 >= a["left"] + a["width"]
                    or y2 <= a["top"] or y1 >= a["top"] + a["height"])


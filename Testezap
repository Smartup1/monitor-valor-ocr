# ANÁLISE DE COR (inalterado)
# ==========================================================
def _assinatura_cor(bgr):
    hsv = cv2.cvtColor(bgr, cv2.COLOR_BGR2HSV)
    mask = hsv[:, :, 2] > 30
    if not np.any(mask):
        mask = np.ones_like(mask, dtype=bool)
    h = hsv[:, :, 0][mask]
    s = hsv[:, :, 1][mask]
    v = hsv[:, :, 2][mask]
    h_rad = np.deg2rad(h.astype(np.float32) * 2)
    h_mean = (np.rad2deg(np.arctan2(np.sin(h_rad).mean(), np.cos(h_rad).mean())) / 2) % 180
    rgb = bgr[:, :, ::-1]
    return {
        "h": float(h_mean),
        "s": float(s.mean()),
        "v": float(v.mean()),
        "r": float(rgb[:, :, 0].mean()),
        "g": float(rgb[:, :, 1].mean()),
        "b": float(rgb[:, :, 2].mean()),
        "std_h": float(np.std(h)),
        "std_s": float(np.std(s)),
    }


def distancia_cor(assin_a, assin_b):
    dh = abs(assin_a["h"] - assin_b["h"])
    dh = min(dh, 180 - dh) * (100.0 / 90.0)
    ds = abs(assin_a["s"] - assin_b["s"]) * (100.0 / 255.0)
    dv = abs(assin_a["v"] - assin_b["v"]) * (100.0 / 255.0)
    drgb = (abs(assin_a["r"] - assin_b["r"]) +
            abs(assin_a["g"] - assin_b["g"]) +
            abs(assin_a["b"] - assin_b["b"])) / 3.0 * (100.0 / 255.0)
    return 0.35 * dh + 0.10 * ds + 0.10 * dv + 0.45 * drgb


def cor_media_rgb(bgr):
    rgb = bgr[:, :, ::-1]
    return (int(rgb[:, :, 0].mean()),
            int(rgb[:, :, 1].mean()),
            int(rgb[:, :, 2].mean()))


# ==========================================================
# ALARME SONORO (inalterado)
# ==========================================================
class Sirene:
    def __init__(self):
        self._parada = None

    @property
    def tocando(self):
        return self._parada is not None and not self._parada.is_set()

    def iniciar(self):
        if self.tocando:
            return
        self._parada = threading.Event()
        threading.Thread(target=self._loop, args=(self._parada,), daemon=True).start()

    def parar(self):
        if self._parada is not None:
            self._parada.set()

    @staticmethod
    def _bip():
        if winsound:
            try:
                winsound.Beep(SOM_FREQ_HZ, SOM_DURACAO_MS)
                return
            except Exception:
                pass
            try:
                winsound.MessageBeep()
                return
            except Exception:
                pass
        print("\a", end="", flush=True)

    def _loop(self, parada):
        while not parada.is_set():
            try:
                self._bip()
            except Exception:
                pass
            parada.wait(SOM_PAUSA_S)


def ler_limite(texto):
    texto = texto.strip().replace(",", ".")
    if not texto:
        return None
    return float(texto)



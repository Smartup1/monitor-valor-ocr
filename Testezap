# ANÁLISE DE COR
# ==========================================================
def _assinatura_cor(bgr):
    """Retorna assinatura robusta da cor de uma região BGR:
    - média HSV (hue 0-179, sat 0-255, val 0-255)
    - média RGB
    - desvio padrão do HSV (para saber se é uniforme ou colorido)
    """
    hsv = cv2.cvtColor(bgr, cv2.COLOR_BGR2HSV)
    # ignora pixels muito escuros (ruído) para não poluir a média de hue
    mask = hsv[:, :, 2] > 30
    if not np.any(mask):
        mask = np.ones_like(mask, dtype=bool)
    h = hsv[:, :, 0][mask]
    s = hsv[:, :, 1][mask]
    v = hsv[:, :, 2][mask]
    # média circular do hue (evita problema 0/179)
    h_rad = np.deg2rad(h.astype(np.float32) * 2)
    h_mean = (np.rad2deg(np.arctan2(np.sin(h_rad).mean(), np.cos(h_rad).mean())) / 2) % 180
    rgb = bgr[:, :, ::-1]
    return {
        "h": float(h_mean),
        "s": float(s.mean()),
        "v": float(v.mean()),
        "r": float(rgb[:, :, 0].mean()),
        "g": float(rgb[:, :, 1].mean()),
        "b": float(rgb[:, :, 2].mean()),
        "std_h": float(np.std(h)),
        "std_s": float(np.std(s)),
    }


def distancia_cor(assin_a, assin_b):
    """Distância combinada: diferença de hue (circular) + saturação + brilho + RGB.
    Retorna valor em escala ~0-100."""
    dh = abs(assin_a["h"] - assin_b["h"])
    dh = min(dh, 180 - dh) * (100.0 / 90.0)   # normaliza 0-100
    ds = abs(assin_a["s"] - assin_b["s"]) * (100.0 / 255.0)
    dv = abs(assin_a["v"] - assin_b["v"]) * (100.0 / 255.0)
    drgb = (abs(assin_a["r"] - assin_b["r"]) +
            abs(assin_a["g"] - assin_b["g"]) +
            abs(assin_a["b"] - assin_b["b"])) / 3.0 * (100.0 / 255.0)
    # peso maior para hue/RGB (mudança real de cor); sat/brilho pesam menos
    return 0.35 * dh + 0.10 * ds + 0.10 * dv + 0.45 * drgb


def cor_media_rgb(bgr):
    rgb = bgr[:, :, ::-1]
    return (int(rgb[:, :, 0].mean()),
            int(rgb[:, :, 1].mean()),
            int(rgb[:, :, 2].mean()))



    def ler_limite_parado(self):
        try:
            return max(0.0, float(self.var_parado.get().replace(",", ".")))
        except ValueError:
            return float(PARADO_PADRAO_S)

    def ler_limite_ilegivel(self):
        try:
            return max(0.0, float(self.var_ilegivel.get().replace(",", ".")))
        except ValueError:
            return float(ILEGIVEL_PADRAO_S)

    def ler_tolerancia_cor(self):
        try:
            return max(0.0, float(self.var_tol_cor.get().replace(",", ".")))
        except ValueError:
            return TOLERANCIA_COR_PADRAO

    def reiniciar_detector_parado(self):
        self.ultimo_valor = None
        self.t_mudanca = None
        self.t_ilegivel = None

    def ler_confirmacoes_volta(self):
        try:
            return max(1, int(float(self.var_conf_volta.get().replace(",", "."))))
        except ValueError:
            return CONFIRMACOES_VOLTA_PADRAO

    # ---------- COR DE REFERÊNCIA ----------
    def recapturar_cor_ref(self):
        """Recaptura a cor da área atual como nova referência."""
        if self.area is None:
            self.lbl_status.config(text="Selecione a área primeiro", fg="red")
            return
        try:
            bgr = capturar_area_cv(self.area)
        except Exception as e:
            self.escrever_log(f"Erro ao capturar cor: {e!r}")
            return
        self.cor_referencia = _assinatura_cor(bgr)
        self.cor_referencia_rgb = cor_media_rgb(bgr)
        self.cont_cor_ruim = 0
        self.cont_cor_boa = 0
        r, g, b = self.cor_referencia_rgb
        self.escrever_log(f"Cor de referência (RGB): ({r},{g},{b})")
        self.lbl_cor_info.config(text=f"ref\n{r},{g},{b}", fg="gray")
        self._atualizar_amostra_cor(bgr, ref=True)

    def _atualizar_amostra_cor(self, bgr, ref=False, diferente=False):
        r, g, b = cor_media_rgb(bgr)
        hex_cor = f"#{r:02x}{g:02x}{b:02x}"
        borda = self.cor_alarme if diferente else ("green" if not ref else "gray")
        self.lbl_cor_atual.config(bg=hex_cor, highlightbackground=borda,
                                  highlightcolor=borda, highlightthickness=2)
        if not ref:
            self.lbl_cor_info.config(text=f"atual\n{r},{g},{b}", fg=borda)

    def verificar_mudanca_cor(self, n_conf, n_volta):
        """Compara a cor atual com a referência.
        Retorna True se alarme disparado agora.
        Se a cor voltar à referência, rearma automaticamente."""
        if self.cor_referencia is None:
            return False
        try:
            bgr = capturar_area_cv(self.area)
        except Exception as e:
            self.escrever_log(f"Erro ao ler cor: {e!r}")
            return False

        assin_atual = _assinatura_cor(bgr)
        dist = distancia_cor(self.cor_referencia, assin_atual)
        tol = self.ler_tolerancia_cor()
        mudou = dist > tol

        self._atualizar_amostra_cor(bgr, diferente=mudou)

        if not mudou:
            self.cont_cor_ruim = 0
            # Se estava ALARMANDO por cor, volta a rearmar
            if self.estado == ALARMANDO:
                self.cont_cor_boa += 1
                if self.cont_cor_boa >= n_volta:
                    self.escrever_log(f"Cor voltou ao normal (dist={dist:.1f}). Rearmando.")
                    self.rearmar(f"cor dist={dist:.1f}")
                else:
                    self.lbl_status.config(
                        text=f"Cor voltando: {self.cont_cor_boa}/{n_volta}", fg="green")
            elif self.estado == RECONHECIDO:
                self.cont_cor_boa += 1
                if self.cont_cor_boa >= n_volta:
                    self.rearmar(f"cor dist={dist:.1f}")
            return False

        # cor mudou
        self.cont_cor_boa = 0
        self.cont_cor_ruim += 1
        motivo = f"cor mudou (dist={dist:.1f} > tol={tol:.1f})"
        self.escrever_log(f"Cor diferente ({self.cont_cor_ruim}/{n_conf}): dist={dist:.1f}")
        if self.cont_cor_ruim >= n_conf:
            self.tratar_zona_ruim([motivo], n_conf, forcar=True)
            return True
        else:
            self.lbl_status.config(
                text=f"Cor mudou: confirmando {self.cont_cor_ruim}/{n_conf} (dist={dist:.1f})",
                fg="#e65100")
        return False

    # ---------- texto de referência ----------
    def capturar_texto_referencia(self):
        if self.area is None:
            return
        try:
            texto = extrair_texto_completo(self.area)
        except Exception as e:
            self.escrever_log(f"Erro ao capturar texto de referência: {e!r}")
            return
        self.texto_referencia = normalizar_texto(texto)
        if self.texto_referencia:
            self.lbl_texto_ref.config(
                text=f"Texto ref.: {texto[:60]!r}", foreground="black")
            self.escrever_log(f"Texto de referência capturado: {texto!r}")
        else:
            self.lbl_texto_ref.config(
                text="Texto ref.: (vazio)", foreground="gray")
            self.escrever_log("Texto de referência capturado: (vazio)")
        self.cont_texto_ruim = 0

    def verificar_mudanca_texto(self, n_conf):
        if self.texto_referencia is None:
            return False
        try:
            texto_atual = extrair_texto_completo(self.area)
        except Exception as e:
            self.escrever_log(f"Erro ao ler texto para comparação: {e!r}")
            return False

        self.ultimo_texto_lido = texto_atual
        self.lbl_texto_atual.config(text=texto_atual if texto_atual else "(vazio)")

        texto_atual_norm = normalizar_texto(texto_atual)
        if texto_atual_norm == self.texto_referencia:
            self.cont_texto_ruim = 0
            self.lbl_texto_atual.config(fg="green")
            return False

        self.lbl_texto_atual.config(fg=self.cor_alarme)
        self.cont_texto_ruim += 1
        self.escrever_log(
            f"Texto difere ({self.cont_texto_ruim}/{n_conf}): "
            f"ref={self.texto_referencia!r} atual={texto_atual_norm!r}")
        if self.cont_texto_ruim >= n_conf:
            motivo = f"texto mudou (antes: {self.texto_referencia!r}, agora: {texto_atual_norm!r})"
            self.tratar_zona_ruim([motivo], n_conf, forcar=True)
            return True
        return False

    # ---------- estado ----------
    def _mostrar_estado(self):
        textos = {
            ARMADO: ("ARMADO", "green"),
            ALARMANDO: ("ALARMANDO — clique em RECONHECER", self.cor_alarme),
            RECONHECIDO: ("RECONHECIDO — aguardando voltar", "#e65100"),
        }
        txt, cor = textos[self.estado]
        self.lbl_estado.config(text=f"Estado: {txt}", fg=cor)

    def mudar_estado(self, novo):
        if novo != self.estado:
            self.escrever_log(f"Estado: {self.estado} -> {novo}")
        self.estado = novo
        self._mostrar_estado()

    def disparar_alarme(self, trazer_frente=True):
        self.sirene.iniciar()
        self.btn_reconhecer.config(state="normal")
        if trazer_frente:
            self.root.lift()
        if not self._piscando:
            self._piscando = True
            self._piscar(True)

    def _piscar(self, ligado):
        if not self.sirene.tocando:
            self._piscando = False
            self.btn_reconhecer.config(bg=self.cor_alarme)
            return
        self.btn_reconhecer.config(bg=self.cor_alarme_pisca if ligado else self.cor_alarme)
        self.root.after(400, self._piscar, not ligado)

    def parar_sirene(self):
        self.sirene.parar()
        self.btn_reconhecer.config(state="disabled", bg=self.cor_alarme)

    def on_reconhecer(self):
        if self.estado != ALARMANDO:
            return
        self.parar_sirene()
        self.cont_boa = 0
        self.cont_texto_ruim = 0
        self.cont_cor_ruim = 0
        self.mudar_estado(RECONHECIDO)
        self.lbl_status.config(text="Alarme reconhecido", fg="#e65100")

    def rearmar(self, valores_txt):
        self.parar_sirene()
        self.cont_ruim = 0
        self.cont_boa = 0
        self.cont_texto_ruim = 0
        self.cont_cor_ruim = 0
        self.cont_cor_boa = 0
        self.mudar_estado(ARMADO)
        self.escrever_log(f"Normalizou ({valores_txt}). Alarme rearmado.")
        self.lbl_status.config(text="Tudo normal — OK (rearmado)", fg="green")

    # ---------- ações ----------
    def on_selecionar(self):
        self.root.withdraw()
        self.root.update()
        time.sleep(ESPERA_JANELA_SUMIR)
        try:
            area = selecionar_area()
        finally:
            self.root.deiconify()
            self.root.attributes("-topmost", True)

        if area is None:
            self.escrever_log("Seleção cancelada.")
            return
        self.area = area
        self.lbl_area.config(
            text=f"{area['width']}x{area['height']} @({area['left']},{area['top']})",
            foreground="black",
        )
        self.escrever_log(f"Área selecionada: {area}")
        self.parar_sirene()
        self.cont_ruim = 0
        self.cont_boa = 0
        self.reiniciar_detector_parado()
        self.mudar_estado(ARMADO)

        self.capturar_texto_referencia()
        self.recapturar_cor_ref()
        try:
            t = extrair_texto_completo(self.area)
            self.ultimo_texto_lido = t
            self.lbl_texto_atual.config(text=t if t else "(vazio)", fg="black")
        except Exception:
            pass

    def on_alternar(self):
        if self.monitorando:
            self.monitorando = False
            if self._after_id is not None:
                self.root.after_cancel(self._after_id)
                self._after_id = None
            self.btn_iniciar.config(text="INICIAR")
            self.lbl_status.config(text="Monitoramento parado", fg="gray")
            self.escrever_log("Monitoramento parado.")
            return

        if self.area is None:
            self.lbl_status.config(text="Selecione a área primeiro", fg="red")
            return

        modo = self.var_modo.get()
        if modo in (MODO_TEXTO, MODO_AMBOS) and self.texto_referencia is None:
            self.capturar_texto_referencia()
        if modo in (MODO_COR, MODO_AMBOS) and self.cor_referencia is None:
            self.recapturar_cor_ref()

        self.monitorando = True
        self.reiniciar_detector_parado()
        self.btn_iniciar.config(text="PARAR")
        self.escrever_log(f"Monitoramento iniciado (modo {modo}).")
        self._ciclo()

    def on_ler_agora(self):
        if self.area is None:
            self.lbl_status.config(text="Selecione a área primeiro", fg="red")
            return
        self._ler_protegido()

    def _ler_protegido(self):
        try:
            self.ler_e_avaliar()
        except Exception as e:
            self.lbl_status.config(text=f"Erro inesperado: {e}", fg="red")
            self.escrever_log(f"Erro inesperado: {e!r}")

    def _ciclo(self):
        if not self.monitorando:
            return
        self._ler_protegido()
        try:
            seg = max(0.5, float(self.var_int.get().replace(",", ".")))
        except ValueError:
            seg = INTERVALO_PADRAO_S
        self._after_id = self.root.after(int(seg * 1000), self._ciclo)

    # ---------- zona ruim ----------
    def tratar_zona_ruim(self, motivos, n_conf, forcar=False):
        self.lbl_valor.config(fg=self.cor_alarme)
        self.cont_boa = 0
        texto_motivos = "; ".join(motivos)

        if self.estado == ARMADO:
            self.cont_ruim += 1
            if self.cont_ruim >= n_conf or forcar:
                self.mudar_estado(ALARMANDO)
                self.lbl_status.config(text="ALARME: " + texto_motivos, fg=self.cor_alarme)
                self.escrever_log(f"ALARME confirmado: {texto_motivos}")
                self.disparar_alarme(trazer_frente=True)
            else:
                self.lbl_status.config(
                    text=f"Fora: confirmando {self.cont_ruim}/{n_conf} ({texto_motivos})",
                    fg="#e65100")
                self.escrever_log(f"Fora, confirmando {self.cont_ruim}/{n_conf}: {texto_motivos}")
        elif self.estado == ALARMANDO:
            self.lbl_status.config(text="ALARME: " + texto_motivos, fg=self.cor_alarme)
            self.disparar_alarme(trazer_frente=False)
        else:
            self.lbl_status.config(text="Reconhecido, condição persiste: " + texto_motivos, fg="#e65100")

    # ---------- leitura e decisão ----------
    def ler_e_avaliar(self):
        modo = self.var_modo.get()
        usa_numero = modo in (MODO_NUMERO, MODO_AMBOS)
        usa_texto = modo in (MODO_TEXTO, MODO_AMBOS)
        usa_cor = modo in (MODO_COR, MODO_AMBOS)

        try:
            limite_max = ler_limite(self.var_max.get())
            limite_min = ler_limite(self.var_min.get())
        except ValueError:
            self.lbl_status.config(text="Limite inválido", fg="red")
            return

        n_conf = self.ler_confirmacoes()
        n_volta = self.ler_confirmacoes_volta()

        self.lbl_aviso.config(
            text="⚠ Janela sobre a área lida — mova-a."
            if self.janela_sobre_area() else ""
        )

        agora = time.monotonic()
        limite_ileg = self.ler_limite_ilegivel()

        # ---- TEXTO ----
        if usa_texto and self.texto_referencia is not None:
            if self.verificar_mudanca_texto(n_conf):
                return

        # ---- COR ----
        if usa_cor and self.cor_referencia is not None:
            if self.verificar_mudanca_cor(n_conf, n_volta):
                return

        if not usa_numero:
            if usa_texto or usa_cor:
                self.lbl_valor.config(text="—")
            return

        # ---- NÚMERO ----
        try:
            texto, valor = extrair_numeros(self.area)
        except Exception as e:
            self.lbl_status.config(text=f"Erro na leitura: {e}", fg="red")
            self.escrever_log(f"Erro na leitura: {e}")
            if self.t_ilegivel is None:
                self.t_ilegivel = agora
            ileg_seg = agora - self.t_ilegivel
            if limite_ileg > 0 and ileg_seg > limite_ileg:
                self.tratar_zona_ruim([f"sem ler há {int(ileg_seg)}s"], n_conf, forcar=True)
            return

        if valor is None:
            self.registrar_leitura(texto, "?")
            self.lbl_valor.config(text="?", fg="orange")
            if self.t_ilegivel is None:
                self.t_ilegivel = agora
            ileg_seg = agora - self.t_ilegivel
            if limite_ileg > 0 and ileg_seg > limite_ileg:
                self.tratar_zona_ruim([f"sem ler há {int(ileg_seg)}s"], n_conf, forcar=True)
            else:
                self.lbl_status.config(text=f"Sem número (há {int(ileg_seg)}s)", fg="orange")
            return

        self.t_ilegivel = None

        valores_txt = f"{valor:g}"
        self.lbl_valor.config(text=valores_txt)

        absoluto = bool(self.var_abs.get())
        ref = abs(valor) if absoluto else valor
        rotulo = f"|{valor:g}|" if absoluto else f"{valor:g}"

        motivos = []
        if limite_max is not None and ref > limite_max:
            motivos.append(f"{rotulo} > {limite_max:g}")
        if limite_min is not None and ref < limite_min:
            motivos.append(f"{rotulo} < {limite_min:g}")

        if self.ultimo_valor is None or abs(valor - self.ultimo_valor) > TOLERANCIA_MUDANCA:
            self.ultimo_valor = valor
            self.t_mudanca = agora
        limite_parado = self.ler_limite_parado()
        parado_seg = agora - self.t_mudanca
        parado = limite_parado > 0 and parado_seg > limite_parado
        if parado:
            motivos.append(f"parado há {int(parado_seg)}s")

        self.registrar_leitura(texto, f"{valor:g}{'✗' if motivos else '✓'}")

        if not motivos:
            self.lbl_valor.config(fg="green")
            self.cont_ruim = 0
            if self.estado == ARMADO:
                self.cont_boa = 0
                self.lbl_status.config(text="Dentro da faixa — OK", fg="green")
            else:
                self.cont_boa += 1
                if self.cont_boa >= n_volta:
                    self.rearmar(valores_txt)
                else:
                    self.lbl_status.config(
                        text=f"Voltando: {self.cont_boa}/{n_volta}", fg="green")
            return

        self.tratar_zona_ruim(motivos, n_conf, forcar=parado)

    def on_fechar(self):
        self.monitorando = False
        self.sirene.parar()
        self.root.destroy()


def main():
    root = tk.Tk()
    App(root)
    root.mainloop()


if __name__ == "__main__":
    main()

def capturar_tela_inteira():
    with mss() as sct:
        monitor = sct.monitors[INDICE_MONITOR]
        img = np.array(sct.grab(monitor))
    frame = cv2.cvtColor(img, cv2.COLOR_BGRA2BGR)
    return frame, monitor


def capturar_area(area):
    with mss() as sct:
        img = np.array(sct.grab(area))
    return Image.fromarray(img[:, :, :3])


def selecionar_area():
    frame, monitor = capturar_tela_inteira()
    titulo = "Selecione a area (ENTER confirma, ESC cancela)"
    roi = cv2.selectROI(titulo, frame, False, False)
    cv2.destroyWindow(titulo)

    x, y, w, h = roi
    if w <= 0 or h <= 0:
        return None
    return {
        "left": int(x + monitor["left"]),
        "top": int(y + monitor["top"]),
        "width": int(w),
        "height": int(h),
    }


def preprocessar_para_ocr(imagem):
    cinza = np.array(imagem.convert("L"))
    cinza = cv2.resize(cinza, None, fx=4, fy=4, interpolation=cv2.INTER_LANCZOS4)
    cinza = cv2.medianBlur(cinza, 3)
    binarizada = cv2.adaptiveThreshold(
        cinza, 255, cv2.ADAPTIVE_THRESH_GAUSSIAN_C,
        cv2.THRESH_BINARY, blockSize=35, C=10,
    )
    if np.mean(binarizada) < 127:
        binarizada = cv2.bitwise_not(binarizada)
    return Image.fromarray(binarizada)


def preprocessar_otsu(imagem):
    """Alternativa de pré-processamento (limiar global), para quando o valor muda de cor/fundo."""
    cinza = np.array(imagem.convert("L"))
    cinza = cv2.resize(cinza, None, fx=4, fy=4, interpolation=cv2.INTER_LANCZOS4)
    cinza = cv2.GaussianBlur(cinza, (3, 3), 0)
    _, binarizada = cv2.threshold(cinza, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)
    if np.mean(binarizada) < 127:
        binarizada = cv2.bitwise_not(binarizada)
    return Image.fromarray(binarizada)


def _ler_texto(img, psm):
    config = f"--psm {psm} -c tessedit_char_whitelist=0123456789,.-−"
    return pytesseract.image_to_string(img, config=config).strip()


def _valor_principal(texto):
    """Número com mais dígitos do texto (lixo do OCR costuma ser curto). None se não houver."""
    candidatos = []  # (qtd_digitos, valor)
    for n in re.findall(r"[-−]?\d+[.,]?\d*", texto):
        try:
            valor = float(n.replace("−", "-").replace(",", "."))
        except ValueError:
            continue
        candidatos.append((len(re.sub(r"\D", "", n)), valor))
    if not candidatos:
        return None
    return max(candidatos, key=lambda c: c[0])[1]  # empate = o primeiro


def extrair_numeros(area):
    imagem = capturar_area(area)

    # 1ª tentativa: exatamente o método que já funcionava.
    texto = _ler_texto(preprocessar_para_ocr(imagem), 6)
    valor = _valor_principal(texto)
    if valor is not None:
        return texto, valor

    # Só se não leu número nenhum: tenta alternativas (linha única / outro limiar).
    otsu = preprocessar_otsu(imagem)
    for img, psm in ((otsu, 7), (otsu, 6)):
        try:
            t = _ler_texto(img, psm)
        except Exception:
            continue
        v = _valor_principal(t)
        if v is not None:
            return t, v
    return texto, None


# ==========================================================
# ALARME SONORO
# ==========================================================
class Sirene:
    """Bipes em loop numa thread. Cada início cria um sinal próprio de parada,
    então parar e iniciar de novo nunca deixa duas threads tocando juntas."""

    def __init__(self):
        self._parada = None

    @property
    def tocando(self):
        return self._parada is not None and not self._parada.is_set()

    def iniciar(self):
        if self.tocando:
            return
        self._parada = threading.Event()
        threading.Thread(target=self._loop, args=(self._parada,), daemon=True).start()

    def parar(self):
        if self._parada is not None:
            self._parada.set()

    @staticmethod
    def _bip():
        if winsound:
            try:
                winsound.Beep(SOM_FREQ_HZ, SOM_DURACAO_MS)
                return
            except Exception:
                pass
            try:
                winsound.MessageBeep()  # alternativa se o Beep falhar
                return
            except Exception:
                pass
        print("\a", end="", flush=True)

    def _loop(self, parada):
        # try/except: uma falha de som nunca pode matar a thread em silêncio
        while not parada.is_set():
            try:
                self._bip()
            except Exception:
                pass
            parada.wait(SOM_PAUSA_S)



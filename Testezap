def capturar_tela_inteira():
    with mss() as sct:
        monitor = sct.monitors[INDICE_MONITOR]
        img = np.array(sct.grab(monitor))
    frame = cv2.cvtColor(img, cv2.COLOR_BGRA2BGR)
    return frame, monitor


def capturar_area(area):
    with mss() as sct:
        img = np.array(sct.grab(area))
    return Image.fromarray(img[:, :, :3])


def capturar_area_cv(area):
    """Retorna a área como array BGR (para análise de cor)."""
    with mss() as sct:
        img = np.array(sct.grab(area))
    return img[:, :, :3].copy()  # BGR


def selecionar_area():
    frame, monitor = capturar_tela_inteira()
    titulo = "Selecione a area (ENTER confirma, ESC cancela)"
    roi = cv2.selectROI(titulo, frame, False, False)
    cv2.destroyWindow(titulo)

    x, y, w, h = roi
    if w <= 0 or h <= 0:
        return None
    return {
        "left": int(x + monitor["left"]),
        "top": int(y + monitor["top"]),
        "width": int(w),
        "height": int(h),
    }


def preprocessar_para_ocr(imagem):
    cinza = np.array(imagem.convert("L"))
    cinza = cv2.resize(cinza, None, fx=4, fy=4, interpolation=cv2.INTER_LANCZOS4)
    cinza = cv2.medianBlur(cinza, 3)
    binarizada = cv2.adaptiveThreshold(
        cinza, 255, cv2.ADAPTIVE_THRESH_GAUSSIAN_C,
        cv2.THRESH_BINARY, blockSize=35, C=10,
    )
    if np.mean(binarizada) < 127:
        binarizada = cv2.bitwise_not(binarizada)
    return Image.fromarray(binarizada)


def preprocessar_otsu(imagem):
    cinza = np.array(imagem.convert("L"))
    cinza = cv2.resize(cinza, None, fx=4, fy=4, interpolation=cv2.INTER_LANCZOS4)
    cinza = cv2.GaussianBlur(cinza, (3, 3), 0)
    _, binarizada = cv2.threshold(cinza, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)
    if np.mean(binarizada) < 127:
        binarizada = cv2.bitwise_not(binarizada)
    return Image.fromarray(binarizada)


def _ler_texto(img, psm):
    config = f"--psm {psm} -c tessedit_char_whitelist=0123456789,.-−"
    return pytesseract.image_to_string(img, config=config).strip()


def _ler_texto_completo(img, psm):
    config = f"--psm {psm}"
    return pytesseract.image_to_string(img, config=config).strip()


def _valor_principal(texto):
    candidatos = []
    for n in re.findall(r"[-−]?\d+[.,]?\d*", texto):
        try:
            valor = float(n.replace("−", "-").replace(",", "."))
        except ValueError:
            continue
        candidatos.append((len(re.sub(r"\D", "", n)), valor))
    if not candidatos:
        return None
    return max(candidatos, key=lambda c: c[0])[1]


def extrair_numeros(area):
    imagem = capturar_area(area)
    texto = _ler_texto(preprocessar_para_ocr(imagem), 6)
    valor = _valor_principal(texto)
    if valor is not None:
        return texto, valor
    otsu = preprocessar_otsu(imagem)
    for img, psm in ((otsu, 7), (otsu, 6)):
        try:
            t = _ler_texto(img, psm)
        except Exception:
            continue
        v = _valor_principal(t)
        if v is not None:
            return t, v
    return texto, None


def extrair_texto_completo(area):
    imagem = capturar_area(area)
    img_proc = preprocessar_para_ocr(imagem)
    try:
        texto = _ler_texto_completo(img_proc, 6)
        if texto.strip():
            return texto
    except Exception:
        pass
    img_otsu = preprocessar_otsu(imagem)
    for psm in (6, 7, 11):
        try:
            t = _ler_texto_completo(img_otsu, psm)
            if t.strip():
                return t
        except Exception:
            continue
    return ""


def normalizar_texto(texto):
    return re.sub(r"\s+", " ", texto.strip().lower())



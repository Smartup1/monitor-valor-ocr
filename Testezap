class Sirene:
    def __init__(self):
        self._parada = None

    @property
    def tocando(self):
        return self._parada is not None and not self._parada.is_set()

    def iniciar(self):
        if self.tocando:
            return
        self._parada = threading.Event()
        threading.Thread(target=self._loop, args=(self._parada,), daemon=True).start()

    def parar(self):
        if self._parada is not None:
            self._parada.set()

    @staticmethod
    def _bip():
        if winsound:
            try:
                winsound.Beep(SOM_FREQ_HZ, SOM_DURACAO_MS)
                return
            except Exception:
                pass
            try:
                winsound.MessageBeep()
                return
            except Exception:
                pass
        print("\a", end="", flush=True)

    def _loop(self, parada):
        while not parada.is_set():
            try:
                self._bip()
            except Exception:
                pass
            parada.wait(SOM_PAUSA_S)


